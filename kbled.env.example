# Copy this file to kbled.env (in this same folder) and edit if needed.
#
# The defaults below are already set for the LVLUP keyboard this tool was
# built for. If you have that same model, you probably don't need to change
# anything - just copy this file to kbled.env as-is and run install.sh.
#
# If pressing your trigger key does nothing after install, or you have a
# different keyboard entirely, see "Finding your own values" in README.md.

# Your keyboard's USB Vendor ID and Product ID. Find yours by running this
# in Terminal while your keyboard is plugged in, then look for your
# keyboard's name in the output:
#   hidutil list
# The two ID columns are shown in hex (e.g. 0xc0f4); you can enter them here
# either as 0xNNNN or as a plain decimal number.
KBLED_VENDOR_ID=0xC0F4
KBLED_PRODUCT_ID=0x10F5

# Which key toggles the backlight, described as a HID "usage page" and
# "usage" number - not a regular key name, because this is read straight off
# the USB wire before macOS turns it into a normal keypress. For this
# keyboard, the key printed "Screen Lock" actually sends the standard
# Scroll Lock code (usage page 7, usage 0x47) - see README.md for how to find
# this for a different key/keyboard using Karabiner-EventViewer.
KBLED_TRIGGER_USAGE_PAGE=7
KBLED_TRIGGER_USAGE=0x47

# The single byte that turns the backlight ON (0x00 always turns it OFF).
# For this keyboard, the LED output report is 1 byte with 3 bits: bit 0
# (0x01) = NumLock, bit 1 (0x02) = CapsLock, bit 2 (0x04) = backlight. Bits
# 0/1 do nothing to the backlight on this model - only bit 2 matters.
KBLED_LED_ON_VALUE=0x04
